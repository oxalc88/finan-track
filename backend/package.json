{
  "name": "finanzas-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/api/index.ts",
    "start": "node --import tsx src/api/index.ts",
    "db:migrate": "tsx src/db/schema.ts",
    "db:seed": "tsx src/db/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check . --fix",
    "format": "biome format . --write",
    "knip": "knip",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "dependencies": {
    "@finanzas/shared-types": "workspace:*",
    "@ai-sdk/google": "^3.0.43",
    "@ai-sdk/groq": "^3.0.31",
    "@ai-sdk/openai-compatible": "^2.0.37",
    "@ai-sdk/xai": "^3.0.74",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@hono/node-server": "^1.19.11",
    "ai": "^6.0.116",
    "better-sqlite3": "^11.7.0",
    "hono": "^4.6.0",
    "ulid": "^2.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.5",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "knip": "^5.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "ultracite": "^7.2.5",
    "vitest": "^2.1.0"
  }
}
