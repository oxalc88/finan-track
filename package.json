{
  "name": "finan-track-monorepo",
  "version": "1.0.0",
  "description": "Cloud-agnostic invoice processing and financial tracking application - Monorepo",
  "private": true,
  "workspaces": [
    "backend",
    "frontend",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=backend",
    "dev:web": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=frontend",
    "build:web": "npm run build --workspace=frontend",
    "build:types": "npm run build --workspace=packages/shared-types",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:prod:up": "docker compose -f docker-compose.prod.yml up -d",
    "docker:prod:down": "docker compose -f docker-compose.prod.yml down",
    "docker:prod:build": "docker compose -f docker-compose.prod.yml build"
  },
  "keywords": [
    "invoice",
    "ocr",
    "financial-tracking",
    "whatsapp",
    "cloud-agnostic",
    "monorepo"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  }
}
