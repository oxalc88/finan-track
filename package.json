{
  "name": "finan-track-monorepo",
  "version": "1.0.0",
  "description": "Personal-finance app: Hono + SQLite backend with a React/Vite SPA frontend",
  "private": true,
  "workspaces": [
    "backend",
    "frontend",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "pnpm --filter finanzas-app dev",
    "dev:web": "pnpm --filter finan-track-frontend dev",
    "build": "pnpm --filter finan-track-frontend build",
    "build:web": "pnpm --filter finan-track-frontend build",
    "build:types": "pnpm --filter @finanzas/shared-types build",
    "test": "pnpm -r --if-present test",
    "test:api": "pnpm --filter finanzas-app test",
    "typecheck": "pnpm -r --if-present typecheck",
    "db:migrate": "pnpm --filter finanzas-app db:migrate",
    "db:seed": "pnpm --filter finanzas-app db:seed",
    "docker:prod:up": "docker compose -f docker-compose.prod.yml up -d",
    "docker:prod:down": "docker compose -f docker-compose.prod.yml down",
    "docker:prod:build": "docker compose -f docker-compose.prod.yml build",
    "docker:prod:logs": "docker compose -f docker-compose.prod.yml logs -f"
  },
  "keywords": [
    "personal-finance",
    "hono",
    "sqlite",
    "monorepo"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.33.0"
}
