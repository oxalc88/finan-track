# Production Environment Variables for finan-track
# Copy this file to .env and update with your actual values

# ==============================================================================
# Database Configuration (PostgreSQL)
# ==============================================================================
POSTGRES_DB=finantrack
POSTGRES_USER=finantrack
POSTGRES_PASSWORD=your_secure_password_here_min_32_chars

# ==============================================================================
# Storage Configuration (MinIO / S3-compatible)
# ==============================================================================
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=your_minio_password_here_min_32_chars
STORAGE_BUCKET=invoices
STORAGE_REGION=us-east-1

# ==============================================================================
# Queue Configuration
# ==============================================================================
# Options: memory, sqs, rabbitmq
QUEUE_TYPE=memory

# If using RabbitMQ:
# RABBITMQ_URL=amqp://user:password@localhost:5672

# If using AWS SQS:
# QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789/queue-name
# AWS_ACCESS_KEY_ID=your_aws_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret
# AWS_REGION=us-east-1

# ==============================================================================
# WhatsApp Integration (Kapso.ai)
# ==============================================================================
# Get these from https://kapso.ai
KAPSO_API_KEY=your_kapso_api_key_here
KAPSO_WEBHOOK_SECRET=your_webhook_secret_here

# ==============================================================================
# OCR Configuration
# ==============================================================================
# Options: tesseract, textract, cloudflare-ai
OCR_PROVIDER=tesseract

# If using AWS Textract:
# AWS_TEXTRACT_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_aws_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret

# If using Cloudflare AI:
# CLOUDFLARE_ACCOUNT_ID=your_account_id
# CLOUDFLARE_API_TOKEN=your_api_token

# ==============================================================================
# Application Configuration
# ==============================================================================
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# ==============================================================================
# Optional: External Services
# ==============================================================================
# Redis (if using external Redis instead of Docker)
# REDIS_URL=redis://localhost:6379

# Sentry (for error tracking)
# SENTRY_DSN=your_sentry_dsn

# ==============================================================================
# Security (Optional)
# ==============================================================================
# JWT_SECRET=your_jwt_secret_here_min_64_chars
# SESSION_SECRET=your_session_secret_here

# CORS_ORIGIN=https://yourdomain.com

# ==============================================================================
# Monitoring (Optional)
# ==============================================================================
# DATADOG_API_KEY=your_datadog_key
# NEW_RELIC_LICENSE_KEY=your_newrelic_key
