# Server Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/finantrack

# Storage (S3-compatible: AWS S3, Cloudflare R2, MinIO)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=invoices
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_FORCE_PATH_STYLE=true

# Queue (sqs, rabbitmq, memory)
QUEUE_TYPE=memory
QUEUE_URL=

# OCR Provider (tesseract, textract, cloudflare-ai)
OCR_PROVIDER=tesseract
OCR_LANGUAGE=eng

# AWS (if using AWS services)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# WhatsApp Integration (Kapso.ai)
KAPSO_API_KEY=
KAPSO_API_URL=https://api.kapso.ai
KAPSO_WEBHOOK_SECRET=

# Cache (redis, memory)
CACHE_TYPE=memory
REDIS_URL=redis://localhost:6379
